<?xml version="1.0" encoding="utf-8"?>
<!--
  Destructive controls get their own shape, not just a redder tint.

  On a #0a0a14 background a "danger" button distinguished only by hue reads as
  decoration — which is how Entrap ended up one thumb-length from Play Audio on
  the old Advanced scroll. A visible border makes the boundary structural: you
  can see you have entered somewhere different before you read the label.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#140809" />
    <stroke android:width="1dp" android:color="#5a2020" />
    <corners android:radius="4dp" />
</shape>
