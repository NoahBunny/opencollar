<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.focusctl"
    android:versionCode="80"
    android:versionName="80.0">

    <uses-sdk android:minSdkVersion="33" android:targetSdkVersion="36" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- POST_NOTIFICATIONS is runtime-granted on Android 13+; the manifest
         declaration alone is not enough. Used by the in-app refresh path to
         fire a heads-up notification when a fresh bunny message lands while
         Lion's Share is backgrounded (process alive but Activity not on
         screen). For Lion's Share fully closed → install the ntfy Android
         app and subscribe to topic "focuslock-<mesh_id>" — that delivers
         instant push without a foreground service in our codebase. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- A3 (optional embedded Tor): the tor-android TorService may run as a
         foreground service. Harmless when the APK is built without
         FOCUSLOCK_TOR_AAR (the service is never started). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <application
        android:label="Lion's Share"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- First-run onboarding wizard (started by MainActivity for result). -->
        <activity
            android:name=".LionOnboardingActivity"
            android:exported="false"
            android:theme="@style/AppTheme"
            android:screenOrientation="portrait" />

        <!-- A3 (optional embedded Tor) — declared as the tor-android AAR does
             (no manifest merger here). Inert without FOCUSLOCK_TOR_AAR. C3
             device-validation: confirm the startForeground type under API 34+. -->
        <service
            android:name="org.torproject.jni.TorService"
            android:exported="false" />

    </application>
</manifest>
